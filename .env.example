# Copy to .env and change the PIN before a real tour.
PORT=4317
HOST=0.0.0.0

# Guide desk password. The pilot default is 2468 so a local demo runs with no setup.
GUIDE_PIN=2468

# mock | gemini | openai
# mock needs no key and is the default when this is unset.
TRANSLATION_PROVIDER=mock

# Primary live speech-to-speech. Paid tier only — the free tier is used to train Google's models.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modular fallback: one key for speech-to-text, translation, and speech.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional model overrides (defaults match the docs checked 31 Oct 2026).
# OPENAI_STT_MODEL=gpt-transcribe
# OPENAI_TRANSLATE_MODEL=gpt-4.1-mini
# OPENAI_TTS_MODEL=tts-1
# GEMINI_LIVE_MODEL=gemini-3.5-live-translate-preview
# GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
# Silence streamed to Gemini after each sentence so the translation finishes (ms; 0 = off)
# GEMINI_SILENCE_PAD_MS=4000
# GEMINI_SILENCE_PAD_MAX_MS=30000
# End sessions with no guide and no guests after this many minutes
# IDLE_SESSION_MINUTES=30

# Pilot cap. The later target is 30 guests.
MAX_GUESTS=6

# Audio is not written to disk unless this is true. Stop audio is held in memory only until the tour ends.
STORE_AUDIO=false

# Comma-separated place names that must not be translated. Replaces the built-in list when set.
# GLOSSARY=Side,Aspendos,Kaymaklı,Derinkuyu,Hagia Sophia

# Public https origin used in the QR code when the guide page is opened through a proxy.
# PUBLIC_BASE_URL=https://translate.example.com
